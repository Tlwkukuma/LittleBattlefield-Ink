; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="小小战地 · 墨线街区"
config/description="A playable 2.5D ink battlefield: move, shoot, breach, capture, replay."
run/main_scene="res://proving_ground.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=75

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.79, 0.79, 0.78, 1)

[shader_globals]

range2_enabled={
"type": "bool",
"value": false
}
range2_wear={
"type": "sampler2D",
"value": "res://assets/range2/ink_wear.svg"
}
range2_materials={
"type": "sampler2D",
"value": "res://assets/range2/depot-materials-v2.png"
}
