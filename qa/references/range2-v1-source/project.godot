; Little Battlefield: a native Godot 2.5D playable slice.
config_version=5

[application]
config/name="小小战地 · 墨线街区"
run/main_scene="res://proving_ground.tscn"
run/max_fps=75
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="A playable 2.5D ink battlefield: move, shoot, breach, capture, replay."

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.79, 0.79, 0.78, 1)

[physics]
common/physics_ticks_per_second=60

[shader_globals]

range2_enabled={
"type": "bool",
"value": false
}
range2_wear={
"type": "sampler2D",
"value": "res://assets/range2/ink_wear.svg"
}
